{
  "name": "@fs/mycroft",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mycroft": "./bin/mycroft.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabe/mycroft.git"
  },
  "homepage": "https://github.com/fabe/mycroft",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "completions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --out-dir dist --platform node --target node18 --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@lingo-reader/epub-parser": "^0.4.5",
    "ai": "^6.0.73",
    "better-sqlite3": "^11.2.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "openai": "^4.104.0",
    "vectra": "^0.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^4.0.18"
  }
}
